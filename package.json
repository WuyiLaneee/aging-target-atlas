{
  "name": "aging-target-pathway-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate:data && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "data:assemble": "node scripts/assemble-data.mjs"
  },
  "dependencies": {
    "cytoscape": "^3.34.4",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
